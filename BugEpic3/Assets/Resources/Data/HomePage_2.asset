  m_Script: {fileID: 11500000, guid: 9f8ef597f82e61d449828c514058e8d5, type: 3}
  m_Name: HomePage_2
  m_EditorClassIdentifier: 
  lines:
  - speaker: Homeridae
    englishText: Hello kids, Nice to see you
    customText: ^$%$^##$##
    chineseText: "\u4F1F\u5927\u7684\u795E! \u662F\u60A8\u5728\u56DE\u5E94\u6211\u4EEC\u5417?"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: The whole world is made of 2d UI
    customText: sdbhjagdyu
    chineseText: "\u6211\u662F\u8377\u866B, \u662F\u201Cepiks\u201D\u7684\u4E66\u8BB0,
      \u6211\u8BB0\u5F55\u7740\u4E00\u6B21\u53C8\u4E00\u6B21\u60A8\u7684\u795E\u8FF9"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: You will be seen as the god of UI
    customText: waibibabo
    chineseText: "xxxx\u8FD9\u91CC\u63D2\u5165\u7C7B\u89C4\u5219\u602A\u8C08\u7684\u89C4\u5219\u4E16\u754C\u89C2"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: seweq
    customText: ^*%&%$%^#^
    chineseText: "\u60A8\u4E00\u5B9A\u80FD\u591F\u7406\u89E3\u6211\u5728\u8BF4\u4EC0\u4E48\u5427!"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: huhuis8
    chineseText: "\u54E6\u5929\u5450\uFF01\u521A\u521A\u6211\u4EFF\u4F5B\u5931\u53BB\u4E86\u751F\u547D"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: '%^&$%^#%$#%'
    chineseText: "\u662F\u60A8\u6551\u4E86\u6211!"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: ^*^%&^$%&^
    chineseText: "\u679C\u7136\u662F\u60A8, \u795E!"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: huhuis8
    chineseText: "\u60A8\u5C31\u662F\u6211\u4EECepiks\u7684\u795E!"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: huhuis8
    chineseText: "\u6211\u771F\u5B9E\u89C1\u5230\u4E86\u795E\u8FF9!"
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: huhuis8
    chineseText: "\u795E, \u60A8\u8FC7\u5F80\u7684\u964D\u4E34\u6211\u90FD\u6709\u4E00\u4E00\u8BB0\u5F55..."
    voiceClip: {fileID: 0}
  - speaker: Homeridae
    englishText: Freeze!
    customText: huhuis8
    chineseText: "\u4F5C\u4E3A\u60A8\u8654\u8BDA\u7684\u4E66\u8BB0\u5B98, \u6211\u6709\u5E78\u80FD\u591F\u4EB2\u773C\u89C1\u5230\u60A8\u7684\u590D\u523B\u5417?"
    voiceClip: {fileID: 0}
